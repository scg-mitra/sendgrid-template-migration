{
  // Linux builds use GTK3 + WebKit2GTK 4.1 (see Makefile). Without this tag,
  // gopls and the Go extension look for GTK4 and report errors.
  "go.buildTags": "gtk3",
  "go.testFlags": ["-race"],
  "gopls": {
    "build.buildFlags": ["-tags=gtk3"]
  },
  // Generated by `make bindings`; don't edit or search by default.
  "files.readonlyInclude": {
    "frontend/src/bindings/**": true
  },
  "search.exclude": {
    "frontend/src/bindings/**": true,
    "frontend/dist/**": true
  },
  // Tailwind CSS v4 class completion in the React components.
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.experimental.classRegex": [
    ["cn\\(([^)]*)\\)", "[\"'`]([^\"'`]*)[\"'`]"]
  ]
}
